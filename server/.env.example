# ==========================================
# HR MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ==========================================

# Application
NODE_ENV=development
PORT=5000
APP_NAME="HR Management Portal"
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database Configuration (MySQL)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=hr_management_db
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# JWT Authentication
JWT_SECRET=super_secret_jwt_access_key_hr_mgmt_2026_x!99$a
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_hr_mgmt_2026_z!77$b
JWT_REFRESH_EXPIRES_IN=7d
RESET_PASSWORD_EXPIRES_IN=3600000 # 1 hour in ms

# Email Configuration (Nodemailer SMTP)
# Set to 'ethereal' for auto test account or provide real SMTP credentials
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HR Management Portal <no-reply@hrmanagement.com>"

# WebSocket Configuration
WS_CORS_ORIGIN=*

# Rate Limiter
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in ms
RATE_LIMIT_MAX=100 # max requests per window
AUTH_RATE_LIMIT_MAX=10 # max failed auth attempts per window

# Cron Jobs (Enable/Disable scheduled tasks)
CRON_ENABLED=true
CRON_ATTENDANCE_SCHEDULE="0 9 * * 1-5" # 9 AM Monday-Friday
CRON_LEAVE_ALERT_SCHEDULE="0 18 * * 1-5" # 6 PM Monday-Friday
CRON_CLEANUP_SCHEDULE="0 0 * * 0" # Midnight every Sunday

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
